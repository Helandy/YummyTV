<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- cleartext нужен для TorrServer/Jackett в LAN (http://192.168.x.x): адрес задаёт пользователь, CIDR здесь нет. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <!-- Ashdi (*.ashdi.vip) и VK подписаны SSL.com TLS RSA Root CA 2022; в хранилище старых прошивок
                 (Android 11 и ниже) его нет, и они падают на «Unacceptable certificate». -->
            <certificates src="@raw/ssl_com_tls_rsa_root_2022" />
        </trust-anchors>
    </base-config>
</network-security-config>
