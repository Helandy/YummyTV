    <string name="glossary_title_term">Тайтл</string>
    <string name="glossary_title_aliases">title, тайтл</string>
    <string name="glossary_title_definition">Отдельный аниме-проект: сериал, фильм или OVA. Нейтральное слово для «этого аниме».</string>
    <string name="glossary_ongoing_term">Онгоинг</string>
    <string name="glossary_ongoing_aliases">ongoing, онгоинг</string>
    <string name="glossary_ongoing_definition">Сериал, который сейчас выходит: новые серии появляются по расписанию, сезон ещё не закончен.</string>
    <string name="glossary_fanservice_term">Фансервис</string>
    <string name="glossary_fanservice_aliases">fanservice, фансервис</string>
    <string name="glossary_fanservice_definition">Сцены, добавленные ради привлечения зрителя, чаще всего откровенные или комичные, не нужные для сюжета.</string>
    <string name="glossary_waifu_term">Вайфу</string>
    <string name="glossary_waifu_aliases">waifu, husbando, вайфу</string>
    <string name="glossary_waifu_definition">Любимая героиня фаната. Для мужского персонажа используют слово «хазбендо».</string>
    <string name="glossary_manga_term">Манга</string>
    <string name="glossary_manga_aliases">manga, манга</string>
    <string name="glossary_manga_definition">Японские комиксы. Многие аниме снимают по манге.</string>
    <string name="glossary_ranobe_term">Ранобэ</string>
    <string name="glossary_ranobe_aliases">ranobe, light novel, LN, ранобэ</string>
    <string name="glossary_ranobe_definition">Короткий роман для подростков с иллюстрациями, частый первоисточник аниме.</string>
    <string name="glossary_isekai_term">Исекай</string>
    <string name="glossary_isekai_aliases">isekai, исекай</string>
    <string name="glossary_isekai_definition">Жанр, где герой попадает в другой мир, часто после смерти или призыва.</string>
    <string name="glossary_shounen_term">Сёнен</string>
    <string name="glossary_shounen_aliases">shounen, shonen, сёнен, шонен</string>
    <string name="glossary_shounen_definition">Для подростков-юношей: экшен, дружба и взросление героя.</string>
    <string name="glossary_shoujo_term">Сёдзё</string>
    <string name="glossary_shoujo_aliases">shoujo, shojo, сёдзё, седзе</string>
    <string name="glossary_shoujo_definition">Для девушек-подростков: романтика, отношения и драма.</string>
    <string name="glossary_seinen_term">Сэйнэн</string>
    <string name="glossary_seinen_aliases">seinen, сэйнэн, сейнен</string>
    <string name="glossary_seinen_definition">Для взрослых мужчин: серьёзные темы и более сложный сюжет.</string>
    <string name="glossary_mecha_term">Меха</string>
    <string name="glossary_mecha_aliases">mecha, меха</string>
    <string name="glossary_mecha_definition">Истории о гигантских роботах, которыми управляют люди.</string>
    <string name="glossary_slice_term">Повседневность</string>
    <string name="glossary_slice_aliases">slice of life, SoL, повседневность</string>
    <string name="glossary_slice_definition">Спокойные истории о повседневной жизни без крупного конфликта.</string>
    <string name="glossary_ova_term">OVA</string>
    <string name="glossary_ova_aliases">OVA, OAV, ова</string>
    <string name="glossary_ova_definition">Серия, выпущенная сразу на носителях или в сети, а не по ТВ; часто бонус после основного сериала.</string>
    <string name="glossary_ona_term">ONA</string>
    <string name="glossary_ona_aliases">ONA, она</string>
    <string name="glossary_ona_definition">Аниме, созданное для выхода в интернете, минуя ТВ.</string>
    <string name="glossary_special_term">Спешл</string>
    <string name="glossary_special_aliases">special, SP, спешл</string>
    <string name="glossary_special_definition">Дополнительная серия вне основной нумерации: рекап, побочная история или закулисье.</string>
    <string name="glossary_source_term">Первоисточник</string>
    <string name="glossary_source_aliases">source, первоисточник</string>
    <string name="glossary_source_definition">Произведение, по которому снято аниме: манга, ранобэ, игра или оригинальная идея.</string>
    <string name="glossary_season_term">Сезон</string>
    <string name="glossary_season_aliases">season, cour, сезон</string>
    <string name="glossary_season_definition">Блок серий, выходящий в течение сезона года; обычно 12–13 или 24–26 серий.</string>
    <string name="glossary_arc_term">Арка</string>
    <string name="glossary_arc_aliases">arc, арка</string>
    <string name="glossary_arc_definition">Крупная сюжетная часть сериала со своим началом и развязкой.</string>
    <string name="glossary_filler_term">Филлер</string>
    <string name="glossary_filler_aliases">filler, филлер</string>
    <string name="glossary_filler_definition">Серии, которых нет в первоисточнике; их добавляют, чтобы аниме не обогнало мангу. Обычно их можно пропустить.</string>
    <string name="glossary_recap_term">Рекап</string>
    <string name="glossary_recap_aliases">recap, рекап</string>
    <string name="glossary_recap_definition">Серия, пересказывающая прошлые события почти без нового материала.</string>
    <string name="glossary_opening_term">Опенинг</string>
    <string name="glossary_opening_aliases">OP, opening, опенинг</string>
    <string name="glossary_opening_definition">Заставка с песней в начале серии. Завершающая называется эндингом (ED).</string>
    <string name="glossary_studio_term">Студия</string>
    <string name="glossary_studio_aliases">studio, студия</string>
    <string name="glossary_studio_definition">Компания, которая рисует аниме, например MAPPA или Bones.</string>
    <string name="glossary_dub_term">Дубляж</string>
    <string name="glossary_dub_aliases">dub, дубляж</string>
    <string name="glossary_dub_definition">Полная замена оригинальных голосов актёрами на другом языке.</string>
    <string name="glossary_voiceover_term">Закадровая озвучка</string>
    <string name="glossary_voiceover_aliases">voiceover, закадр, многоголосая</string>
    <string name="glossary_voiceover_definition">Перевод, начитанный поверх оригинального звука, который тихо слышен на фоне.</string>
    <string name="glossary_fandub_term">Студия озвучки</string>
    <string name="glossary_fandub_aliases">fandub, команда, озвучка</string>
    <string name="glossary_fandub_definition">Команда фанатов или студия, которая озвучивает аниме. В приложении каждая — отдельный вариант озвучки.</string>
    <string name="glossary_seiyuu_term">Сэйю</string>
    <string name="glossary_seiyuu_aliases">seiyuu, сэйю</string>
    <string name="glossary_seiyuu_definition">Японский актёр озвучивания.</string>
    <string name="glossary_subs_term">Субтитры</string>
    <string name="glossary_subs_aliases">subs, сабы, субтитры</string>
    <string name="glossary_subs_definition">Переведённый текст на экране; оригинальная японская озвучка сохраняется.</string>
    <string name="glossary_hardsub_term">Хардсаб</string>
    <string name="glossary_hardsub_aliases">hardsub, хардсаб</string>
    <string name="glossary_hardsub_definition">Субтитры, «вшитые» в картинку. Их нельзя отключить или изменить.</string>
    <string name="glossary_softsub_term">Софтсаб</string>
    <string name="glossary_softsub_aliases">softsub, софтсаб</string>
    <string name="glossary_softsub_definition">Субтитры отдельным слоем: их можно включать, отключать и менять стиль.</string>
    <string name="glossary_raw_term">Рав</string>
    <string name="glossary_raw_aliases">raw, рав</string>
    <string name="glossary_raw_definition">Оригинальный выпуск на японском без перевода.</string>
    <string name="glossary_player_term">Плеер</string>
    <string name="glossary_player_aliases">player, balancer, балансер, источник</string>
    <string name="glossary_player_definition">Источник видео (хостинг), из которого приложение берёт поток. Если один не работает, попробуйте другой.</string>
</resources>
