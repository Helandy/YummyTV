    <string name="glossary_title_term">Тайтл</string>
    <string name="glossary_title_aliases">title, тайтл</string>
    <string name="glossary_title_definition">Окремий аніме-проєкт: серіал, фільм або OVA. Нейтральне слово для «цього аніме».</string>
    <string name="glossary_ongoing_term">Онґоїнґ</string>
    <string name="glossary_ongoing_aliases">ongoing, онґоїнґ, онгоїнг</string>
    <string name="glossary_ongoing_definition">Серіал, який зараз виходить: нові серії з’являються за розкладом, сезон ще не завершено.</string>
    <string name="glossary_fanservice_term">Фансервіс</string>
    <string name="glossary_fanservice_aliases">fanservice, фансервіс</string>
    <string name="glossary_fanservice_definition">Сцени, додані задля привабливості для глядача, найчастіше відверті або комічні, не потрібні для сюжету.</string>
    <string name="glossary_waifu_term">Вайфу</string>
    <string name="glossary_waifu_aliases">waifu, husbando, вайфу</string>
    <string name="glossary_waifu_definition">Улюблена героїня фаната. Для чоловічого персонажа вживають слово «хазбендо».</string>
    <string name="glossary_manga_term">Манґа</string>
    <string name="glossary_manga_aliases">manga, манґа, манга</string>
    <string name="glossary_manga_definition">Японські комікси. Багато аніме знімають за манґою.</string>
    <string name="glossary_ranobe_term">Ранобе</string>
    <string name="glossary_ranobe_aliases">ranobe, light novel, LN, ранобе</string>
    <string name="glossary_ranobe_definition">Короткий роман для підлітків з ілюстраціями, часте першоджерело аніме.</string>
    <string name="glossary_isekai_term">Ісекай</string>
    <string name="glossary_isekai_aliases">isekai, ісекай</string>
    <string name="glossary_isekai_definition">Жанр, де герой потрапляє в інший світ, часто після смерті або призову.</string>
    <string name="glossary_shounen_term">Шьонен</string>
    <string name="glossary_shounen_aliases">shounen, shonen, шьонен, шонен</string>
    <string name="glossary_shounen_definition">Для хлопців-підлітків: екшен, дружба й дорослішання героя.</string>
    <string name="glossary_shoujo_term">Шьоджьо</string>
    <string name="glossary_shoujo_aliases">shoujo, shojo, шьоджьо, шоджо</string>
    <string name="glossary_shoujo_definition">Для дівчат-підлітків: романтика, стосунки та драма.</string>
    <string name="glossary_seinen_term">Сейнен</string>
    <string name="glossary_seinen_aliases">seinen, сейнен</string>
    <string name="glossary_seinen_definition">Для дорослих чоловіків: серйозні теми та складніший сюжет.</string>
    <string name="glossary_mecha_term">Меха</string>
    <string name="glossary_mecha_aliases">mecha, меха</string>
    <string name="glossary_mecha_definition">Історії про гігантських роботів, якими керують люди.</string>
    <string name="glossary_slice_term">Повсякденність</string>
    <string name="glossary_slice_aliases">slice of life, SoL, повсякденність</string>
    <string name="glossary_slice_definition">Спокійні історії про повсякденне життя без великого конфлікту.</string>
    <string name="glossary_ova_term">OVA</string>
    <string name="glossary_ova_aliases">OVA, OAV, ова</string>
    <string name="glossary_ova_definition">Серія, випущена одразу на носіях чи в мережі, а не на ТБ; часто бонус після основного серіалу.</string>
    <string name="glossary_ona_term">ONA</string>
    <string name="glossary_ona_aliases">ONA, она</string>
    <string name="glossary_ona_definition">Аніме, створене для виходу в інтернеті, оминаючи ТБ.</string>
    <string name="glossary_special_term">Спешл</string>
    <string name="glossary_special_aliases">special, SP, спешл</string>
    <string name="glossary_special_definition">Додаткова серія поза основною нумерацією: рекап, побічна історія або закуліссі.</string>
    <string name="glossary_source_term">Першоджерело</string>
    <string name="glossary_source_aliases">source, першоджерело</string>
    <string name="glossary_source_definition">Твір, за яким знято аніме: манґа, ранобе, гра або оригінальна ідея.</string>
    <string name="glossary_season_term">Сезон</string>
    <string name="glossary_season_aliases">season, cour, сезон</string>
    <string name="glossary_season_definition">Блок серій, що виходить протягом сезону року; зазвичай 12–13 або 24–26 серій.</string>
    <string name="glossary_arc_term">Арка</string>
    <string name="glossary_arc_aliases">arc, арка</string>
    <string name="glossary_arc_definition">Велика сюжетна частина серіалу зі своїм початком і розв’язкою.</string>
    <string name="glossary_filler_term">Філер</string>
    <string name="glossary_filler_aliases">filler, філер, філлер</string>
    <string name="glossary_filler_definition">Серії, яких немає в першоджерелі; їх додають, щоб аніме не випередило манґу. Зазвичай їх можна пропустити.</string>
    <string name="glossary_recap_term">Рекап</string>
    <string name="glossary_recap_aliases">recap, рекап</string>
    <string name="glossary_recap_definition">Серія, що переказує попередні події майже без нового матеріалу.</string>
    <string name="glossary_opening_term">Опенінг</string>
    <string name="glossary_opening_aliases">OP, opening, опенінг</string>
    <string name="glossary_opening_definition">Заставка з піснею на початку серії. Завершальна називається ендінгом (ED).</string>
    <string name="glossary_studio_term">Студія</string>
    <string name="glossary_studio_aliases">studio, студія</string>
    <string name="glossary_studio_definition">Компанія, яка малює аніме, наприклад MAPPA або Bones.</string>
    <string name="glossary_dub_term">Дубляж</string>
    <string name="glossary_dub_aliases">dub, дубляж</string>
    <string name="glossary_dub_definition">Повна заміна оригінальних голосів акторами іншою мовою.</string>
    <string name="glossary_voiceover_term">Закадрове озвучення</string>
    <string name="glossary_voiceover_aliases">voiceover, закадр, багатоголосе</string>
    <string name="glossary_voiceover_definition">Переклад, начитаний поверх оригінального звуку, який тихо чути на тлі.</string>
    <string name="glossary_fandub_term">Студія озвучення</string>
    <string name="glossary_fandub_aliases">fandub, команда, озвучка</string>
    <string name="glossary_fandub_definition">Команда фанатів чи студія, яка озвучує аніме. У застосунку кожна — окремий варіант озвучення.</string>
    <string name="glossary_seiyuu_term">Сейю</string>
    <string name="glossary_seiyuu_aliases">seiyuu, сейю</string>
    <string name="glossary_seiyuu_definition">Японський актор озвучення.</string>
    <string name="glossary_subs_term">Субтитри</string>
    <string name="glossary_subs_aliases">subs, саби, субтитри</string>
    <string name="glossary_subs_definition">Перекладений текст на екрані; оригінальна японська озвучка зберігається.</string>
    <string name="glossary_hardsub_term">Хардсаб</string>
    <string name="glossary_hardsub_aliases">hardsub, хардсаб</string>
    <string name="glossary_hardsub_definition">Субтитри, «вшиті» в картинку. Їх не можна вимкнути чи змінити.</string>
    <string name="glossary_softsub_term">Софтсаб</string>
    <string name="glossary_softsub_aliases">softsub, софтсаб</string>
    <string name="glossary_softsub_definition">Субтитри окремим шаром: їх можна вмикати, вимикати й змінювати стиль.</string>
    <string name="glossary_raw_term">Рав</string>
    <string name="glossary_raw_aliases">raw, рав</string>
    <string name="glossary_raw_definition">Оригінальний випуск японською без перекладу.</string>
    <string name="glossary_player_term">Плеєр</string>
    <string name="glossary_player_aliases">player, balancer, балансер, джерело</string>
    <string name="glossary_player_definition">Джерело відео (хостинг), з якого застосунок бере потік. Якщо один не працює, спробуйте інший.</string>
