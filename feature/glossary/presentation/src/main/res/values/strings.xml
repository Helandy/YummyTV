    <string name="glossary_title_term">Title</string>
    <string name="glossary_title_aliases">title, series, show</string>
    <string name="glossary_title_definition">A single anime project: a series, film or OVA. A neutral word for “that show”.</string>
    <string name="glossary_ongoing_term">Ongoing</string>
    <string name="glossary_ongoing_aliases">ongoing, currently airing</string>
    <string name="glossary_ongoing_definition">A series that is still airing: new episodes come out on a schedule and the season is not finished yet.</string>
    <string name="glossary_fanservice_term">Fan service</string>
    <string name="glossary_fanservice_aliases">fanservice, fan service</string>
    <string name="glossary_fanservice_definition">Scenes added to please the audience, usually provocative or comedic, that the plot does not need.</string>
    <string name="glossary_waifu_term">Waifu</string>
    <string name="glossary_waifu_aliases">waifu, husbando</string>
    <string name="glossary_waifu_definition">A fan’s favourite female character. For a male character the word is “husbando”.</string>
    <string name="glossary_manga_term">Manga</string>
    <string name="glossary_manga_aliases">manga</string>
    <string name="glossary_manga_definition">Japanese comics. Many anime are adapted from manga.</string>
    <string name="glossary_ranobe_term">Light novel</string>
    <string name="glossary_ranobe_aliases">ranobe, light novel, LN</string>
    <string name="glossary_ranobe_definition">A short illustrated novel for teenagers, a frequent source for anime.</string>
    <string name="glossary_isekai_term">Isekai</string>
    <string name="glossary_isekai_aliases">isekai, another world</string>
    <string name="glossary_isekai_definition">A genre where the hero ends up in another world, often after dying or being summoned.</string>
    <string name="glossary_shounen_term">Shounen</string>
    <string name="glossary_shounen_aliases">shounen, shonen</string>
    <string name="glossary_shounen_definition">Aimed at teenage boys: action, friendship and the hero’s growth.</string>
    <string name="glossary_shoujo_term">Shoujo</string>
    <string name="glossary_shoujo_aliases">shoujo, shojo</string>
    <string name="glossary_shoujo_definition">Aimed at teenage girls: romance, relationships and drama.</string>
    <string name="glossary_seinen_term">Seinen</string>
    <string name="glossary_seinen_aliases">seinen</string>
    <string name="glossary_seinen_definition">Aimed at adult men: serious themes and a more complex plot.</string>
    <string name="glossary_mecha_term">Mecha</string>
    <string name="glossary_mecha_aliases">mecha</string>
    <string name="glossary_mecha_definition">Stories about giant robots piloted by people.</string>
    <string name="glossary_slice_term">Slice of life</string>
    <string name="glossary_slice_aliases">slice of life, SoL</string>
    <string name="glossary_slice_definition">Calm stories about everyday life with no major conflict.</string>
    <string name="glossary_ova_term">OVA</string>
    <string name="glossary_ova_aliases">OVA, OAV</string>
    <string name="glossary_ova_definition">An episode released straight to disc or online instead of TV, often a bonus after the main series.</string>
    <string name="glossary_ona_term">ONA</string>
    <string name="glossary_ona_aliases">ONA</string>
    <string name="glossary_ona_definition">An anime made for online release, bypassing TV.</string>
    <string name="glossary_special_term">Special</string>
    <string name="glossary_special_aliases">special, SP</string>
    <string name="glossary_special_definition">A bonus episode outside the main numbering: a recap, a side story or a behind-the-scenes.</string>
    <string name="glossary_source_term">Source material</string>
    <string name="glossary_source_aliases">source, original</string>
    <string name="glossary_source_definition">The work the anime is based on: a manga, light novel, game or an original idea.</string>
    <string name="glossary_season_term">Season</string>
    <string name="glossary_season_aliases">season, cour</string>
    <string name="glossary_season_definition">A block of episodes aired over one season of the year, usually 12–13 or 24–26 episodes.</string>
    <string name="glossary_arc_term">Arc</string>
    <string name="glossary_arc_aliases">arc</string>
    <string name="glossary_arc_definition">A large story part of a series with its own beginning and resolution.</string>
    <string name="glossary_filler_term">Filler</string>
    <string name="glossary_filler_aliases">filler</string>
    <string name="glossary_filler_definition">Episodes that are not in the source material, added so the anime does not outrun the manga. Usually skippable.</string>
    <string name="glossary_recap_term">Recap</string>
    <string name="glossary_recap_aliases">recap</string>
    <string name="glossary_recap_definition">An episode that retells earlier events with almost no new material.</string>
    <string name="glossary_opening_term">Opening</string>
    <string name="glossary_opening_aliases">OP, opening</string>
    <string name="glossary_opening_definition">The opening credits with a song at the start of an episode. The closing one is the ending (ED).</string>
    <string name="glossary_studio_term">Studio</string>
    <string name="glossary_studio_aliases">studio</string>
    <string name="glossary_studio_definition">The company that animates the series, for example MAPPA or Bones.</string>
    <string name="glossary_dub_term">Dub</string>
    <string name="glossary_dub_aliases">dub, dubbing</string>
    <string name="glossary_dub_definition">Full voice acting in another language, where actors replace the original voices.</string>
    <string name="glossary_voiceover_term">Voice-over</string>
    <string name="glossary_voiceover_aliases">voiceover, multi-voice</string>
    <string name="glossary_voiceover_definition">A translation read over the original sound, which stays quietly audible in the background.</string>
    <string name="glossary_fandub_term">Dubbing team</string>
    <string name="glossary_fandub_aliases">fandub, studio, team</string>
    <string name="glossary_fandub_definition">A fan team or studio that voices the anime. In the app each one is a separate voice option.</string>
    <string name="glossary_seiyuu_term">Seiyuu</string>
    <string name="glossary_seiyuu_aliases">seiyuu, voice actor</string>
    <string name="glossary_seiyuu_definition">A Japanese voice actor.</string>
    <string name="glossary_subs_term">Subtitles</string>
    <string name="glossary_subs_aliases">subs, subtitles</string>
    <string name="glossary_subs_definition">Translated text on screen while the original Japanese audio stays.</string>
    <string name="glossary_hardsub_term">Hardsub</string>
    <string name="glossary_hardsub_aliases">hardsub</string>
    <string name="glossary_hardsub_definition">Subtitles burned into the picture. They cannot be turned off or changed.</string>
    <string name="glossary_softsub_term">Softsub</string>
    <string name="glossary_softsub_aliases">softsub</string>
    <string name="glossary_softsub_definition">Subtitles stored separately from the video: they can be switched on, off or restyled.</string>
    <string name="glossary_raw_term">Raw</string>
    <string name="glossary_raw_aliases">raw</string>
    <string name="glossary_raw_definition">The original release in Japanese with no translation.</string>
    <string name="glossary_player_term">Player</string>
    <string name="glossary_player_aliases">player, balancer, source</string>
    <string name="glossary_player_definition">A video source (hosting) the app takes the stream from. If one fails, try another.</string>
</resources>
