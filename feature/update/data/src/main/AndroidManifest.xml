<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- Поиск системного установщика, когда confirm-интент сессии указывает на отсутствующий пакет. -->
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".service.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name=".apk.UpdateApkFileProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
